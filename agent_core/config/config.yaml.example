# Runtime configuration knobs — generated from agent_core/config/_knobs.py.
# Copy wanted entries under the `knobs:` section of
# <runtime-home>/settings/config.yaml. Values shown are the defaults.
# Environment overrides: AGENT_CORE_<NAME> with dots as underscores,
# e.g. AGENT_CORE_SUBAGENTS_MAX_LIVE=4.

knobs:
  agent:
    # Artifact-read failures tolerated before the progress guard intervenes. [1..100]
    artifact_acquisition_failure_limit: 3
    # Default milliseconds a hook command may run; per-hook timeouts win. [500..3600000]
    hook_timeout_ms: 60000
    # Maximum [REPLY REQUIRED] nudges before an unanswered child question is backstopped. [0..20]
    max_question_nudges: 3
    # Consecutive no-progress turns tolerated before the turn is stopped. [2..1000]
    no_progress_limit: 12
    # Identical tool-call cycles tolerated before the progress guard intervenes. [2..100]
    repeated_tool_cycle_limit: 3
  collab:
    # Milliseconds a bridge poll cycle may run before it yields. [1000..600000]
    bridge_poll_deadline_ms: 10000
    # Milliseconds between remote-bridge inbox polls. [50..60000]
    bridge_poll_ms: 750
    # Minimum milliseconds between assistant collaboration updates. [1000..3600000]
    min_update_spacing_ms: 20000
    # Milliseconds between collaboration runtime ticks. [100..60000]
    tick_ms: 1500
  comms:
    # Inline byte allowance for inter-agent payloads (SendMessage/Agent tool results and drained child messages) before artifact spill or truncation; they are conversation, not raw command output. [4096..512000]
    inline_result_bytes: 48000
    # Milliseconds between reply-mailbox polls while a SendMessage call is blocked waiting for a reply. [50..10000]
    reply_poll_ms: 500
    # Default milliseconds a SendMessage(expects_reply=true) call waits for the counterpart's reply before returning a visible non-answer. [1000..3600000]
    reply_timeout_ms: 300000
  compaction:
    # Character cap for command output previews in compaction evidence. [100..1000000]
    command_preview_char_limit: 6000
    # Character cap per tool result in the compact evidence fallback passes. [50..1000000]
    compact_tool_result_char_limit: 600
    # Token budget for the transcript evidence given to the compaction model. [5000..1000000]
    evidence_token_budget: 90000
    # Line cap for file previews in compaction evidence. [4..10000]
    file_preview_lines: 48
    # Maximum search matches quoted in compaction evidence. [1..10000]
    match_preview_limit: 32
    # Maximum recent tool exchange pairs preserved verbatim across compaction. [3..100]
    max_preserved_tool_pairs: 10
    # Character cap per message text when building compaction evidence. [200..1000000]
    message_text_char_limit: 8000
    # Minimum recent messages always kept out of compaction. [2..1000]
    min_recent_messages: 20
    # Token budget for a preserved agentic-trace record carried across compaction. [1000..1000000]
    preserved_trace_token_budget: 20000
    # Token budget for the raw tail retained alongside a checkpoint. [1000..10000000]
    raw_tail_token_budget: 40000
    # Token size of the raw transcript tail compaction aims to preserve. [1000..10000000]
    raw_tail_token_target: 100000
    # Retries for a failed compaction synthesis call before compaction is abandoned for the turn. [0..10]
    synthesis_max_retries: 3
    # Milliseconds a compaction synthesis model call may run before it is failed. [10000..3600000]
    synthesis_timeout_ms: 300000
    # Character cap per tool input when building compaction evidence. [100..1000000]
    tool_input_char_limit: 2400
    # Character cap per tool result when building compaction evidence. [100..1000000]
    tool_result_char_limit: 8000
    # Retries for a failed compaction verification call before the unverified checkpoint path is taken. [0..10]
    verification_max_retries: 3
    # Milliseconds a compaction verification model call may run before it is failed. [10000..3600000]
    verification_timeout_ms: 300000
    # Token ceiling for the working-context document compaction maintains. [10000..10000000]
    working_context_token_limit: 200000
  context:
    # Safety margin tokens added to estimated request input sizes. [0..100000]
    estimate_margin_tokens: 2000
    # Raw-context token level at which a durable checkpoint is considered. [10000..10000000]
    raw_checkpoint_token_limit: 200000
    # Context token ceiling that triggers relief handling. [10000..10000000]
    relief_context_token_limit: 200000
    # Character cap per message text under context relief. [100..1000000]
    relief_message_text_chars: 1200
    # Minimum messages always preserved when context-relief trimming activates. [2..1000]
    relief_preserve_min_messages: 12
    # Preferred raw-tail token size when context relief rebuilds the transcript. [1000..10000000]
    relief_raw_tail_tokens: 24000
    # Character cap per tool input under context relief. [50..1000000]
    relief_tool_input_chars: 500
    # Character cap per tool result under context relief. [50..1000000]
    relief_tool_result_chars: 750
  daemon:
    # Milliseconds a connecting client gets to complete the daemon auth handshake. [25..30000]
    auth_timeout_ms: 2000
    # Milliseconds a booting daemon's not-yet-running state file is honored before the boot is treated as wedged and the instance replaced. [1000..3600000]
    boot_grace_ms: 300000
    # Milliseconds the daemon transport waits for a client connection to close cleanly during shutdown. [25..30000]
    close_grace_ms: 250
    # Milliseconds a task record whose process has died keeps its last status before the boot sweep finalizes it as lost. [1000..86400000]
    dead_work_grace_ms: 900000
    # Milliseconds in-flight daemon RPC dispatches get to finish before shutdown cancels them. [100..300000]
    dispatch_drain_ms: 5000
    # Byte size at which a daemon instance's events log is rotated. [65536..1073741824]
    events_rotate_bytes: 33554432
    # Milliseconds between the daemon's checks of its events log for size-based rotation. [1000..3600000]
    events_rotate_check_ms: 300000
    # Bytes read from the tail of a daemon events log when loading recent events. [4096..16777216]
    events_tail_bytes: 65536
    # Milliseconds between the task supervisor's health reconcile sweeps. [100..300000]
    health_tick_ms: 2000
    # Milliseconds between the runtime's liveness checks of its containment daemon; a dead daemon is replaced by exactly one fresh instance. [50..60000]
    heartbeat_ms: 3000
    # Milliseconds to wait for the per-instance daemon-ensure lock before giving up on daemon startup coordination. [100..30000]
    instance_lock_timeout_ms: 5000
    # Milliseconds a dead daemon instance's on-disk directory is kept for diagnosis before the garbage collector removes it. [60000..86400000]
    instance_reap_ms: 3600000
    # Milliseconds the supervisor's live-work verdict cache stays fresh before process liveness is re-verified. [0..600000]
    live_work_cache_ttl_ms: 30000
    # Milliseconds between the containment daemon's sweeps of live children's mailboxes for unannounced to_parent messages (the parent-wake signal). [100..60000]
    mailbox_watch_ms: 1500
    # Milliseconds between the containment daemon's liveness checks of its owner runtime process; owner death kills all owned workers and exits the daemon. [50..60000]
    owner_poll_ms: 2000
    # Default milliseconds a daemon RPC may run before the client fails the call; explicit per-call overrides win. [25..300000]
    rpc_timeout_ms: 30000
    # Milliseconds to wait for a starting containment daemon to accept connections before startup is failed. [25..600000]
    start_timeout_ms: 30000
  images:
    # Default byte cap for all input images together when the provider profile is silent. [65536..41943040]
    max_aggregate_bytes: 20971520
    # Default byte cap per input image when the provider profile is silent. [65536..20971520]
    max_bytes: 5242880
    # Default images accepted per request when the provider profile is silent; bounded by the hardcoded provider ceilings. [1..32]
    max_count: 8
    # Default byte cap for the encoded request carrying image inputs when the provider profile is silent. [65536..58720256]
    max_encoded_request_bytes: 25165824
  mcp:
    # Most-recent MCP blob files kept per blob directory. [1..10000]
    blob_keep: 64
    # Default milliseconds of MCP HTTP body silence tolerated. [500..600000]
    body_idle_timeout_ms: 10000
    # Milliseconds an MCP stdio server gets to exit after close before escalation. [50..60000]
    close_grace_ms: 750
    # Milliseconds to wait for an MCP server to die after SIGKILL. [100..60000]
    close_kill_wait_ms: 2000
    # Milliseconds after closing an MCP server's stdin before termination proceeds. [10..10000]
    close_stdin_grace_ms: 100
    # Default milliseconds to establish an MCP HTTP connection. [500..600000]
    connect_timeout_ms: 10000
    # Default milliseconds to receive MCP HTTP response headers. [500..600000]
    headers_timeout_ms: 10000
    # Inline byte budget for MCP resource payloads before artifact spill. [500..10000000]
    inline_bytes: 8000
    # MCP resources listed per page. [1..1000]
    max_resource_page: 40
    # Default milliseconds per MCP request; per-server settings win. [500..3600000]
    request_timeout_ms: 30000
    # Default milliseconds for an MCP server to start; per-server settings win. [500..600000]
    startup_timeout_ms: 10000
  memory:
    # Maximum durable memory records persisted per project. [1..10000]
    max_records: 48
    # Character cap per durable memory record. [40..100000]
    max_text_chars: 480
    # Maximum durable memory records retrieved into a session's context. [1..1000]
    retrieved_records: 8
    # Token budget for retrieved durable memory in a session's context. [100..1000000]
    retrieved_token_budget: 1600
  payloads:
    # Line cap for the inline diff in a file-change tool result. [10..100000]
    file_change_diff_max_lines: 120
    # Byte target the file-change diff is trimmed toward when the payload is over budget. [500..10000000]
    file_change_diff_target_bytes: 8000
    # Byte cap for a file-change tool result payload before its diff is trimmed. [1000..10000000]
    file_change_result_max_bytes: 12000
    # Inline byte budget for Glob results in the large payload class. [1000..1000000]
    glob_inline_bytes_large: 10000
    # Inline byte budget for Glob results in the medium payload class. [1000..1000000]
    glob_inline_bytes_medium: 8000
    # Inline byte budget for Glob results in the small payload class. [1000..1000000]
    glob_inline_bytes_small: 6000
    # Inline byte budget for Grep results in the large payload class. [1000..1000000]
    grep_inline_bytes_large: 18000
    # Inline byte budget for Grep results in the medium payload class. [1000..1000000]
    grep_inline_bytes_medium: 12000
    # Inline byte budget for Grep results in the small payload class. [1000..1000000]
    grep_inline_bytes_small: 8000
    # Byte ceiling for tool results of families that never spill to artifacts. [4096..512000]
    non_artifact_tool_result_max_bytes: 32000
    # Byte cap per notebook cell source in a NotebookRead page. [100..10000000]
    notebook_cell_source_bytes: 2000
    # Notebook cells per NotebookRead page. [1..1000]
    notebook_cells_per_page: 20
    # Byte cap per sampled notebook cell output. [50..10000000]
    notebook_output_sample_bytes: 600
    # Inline byte budget for Read results in the large payload class. [1000..1000000]
    read_inline_bytes_large: 18000
    # Inline byte budget for Read results in the medium payload class. [1000..1000000]
    read_inline_bytes_medium: 12000
    # Inline byte budget for Read results in the small payload class. [1000..1000000]
    read_inline_bytes_small: 8000
    # Final serialized byte cap for any tool result in the large payload class. [2000..512000]
    result_final_bytes_large: 24000
    # Final serialized byte cap for any tool result in the medium payload class. [2000..512000]
    result_final_bytes_medium: 18000
    # Final serialized byte cap for any tool result in the small payload class. [2000..512000]
    result_final_bytes_small: 12000
    # Inline byte budget for text tool results in the large payload class; line caps derive from it (~20 bytes/line). [1000..1000000]
    text_inline_bytes_large: 18000
    # Inline byte budget for text tool results in the medium payload class; line caps derive from it (~20 bytes/line). [1000..1000000]
    text_inline_bytes_medium: 12000
    # Inline byte budget for text tool results in the small payload class; line caps derive from it (~20 bytes/line). [1000..1000000]
    text_inline_bytes_small: 8000
  process:
    # Milliseconds an owned worker process waits for its activation payload on stdin before exiting. [1000..600000]
    activation_timeout_ms: 30000
    # Milliseconds the Bash termination ladder waits overall before giving up. [500..600000]
    bash_termination_fallback_ms: 4000
    # Milliseconds a Bash process gets after SIGTERM before SIGKILL. [100..60000]
    bash_termination_grace_ms: 1000
    # Milliseconds an owned worker process gets to disappear after SIGKILL before termination is reported as failed. [100..60000]
    kill_grace_ms: 1000
    # Byte cap for a subprocess output spool file before output is truncated. [1048576..4294967296]
    spool_max_bytes: 67108864
    # Milliseconds to wait for leaked stdio readers after a Bash process exits. [100..60000]
    stdio_leak_grace_ms: 2000
    # Milliseconds an owned worker process gets to exit after SIGTERM before the runtime escalates to SIGKILL. [100..60000]
    term_grace_ms: 3000
  provider:
    # Default attempts per Anthropic request before the turn fails; per-call maxAttempts wins. [1..20]
    anthropic_max_attempts: 2
    # Quick-retry delay ladder in milliseconds for Anthropic messages requests; a small random jitter is added on top. [0..600000]
    anthropic_retry_delays_ms:
      - 350
      - 700
    # Byte budget per inline tool-result batch on codex-style responses transports. [1024..10000000]
    codex_inline_tool_result_batch_bytes: 24000
    # Fraction of the compaction threshold reserved as output headroom for the compaction model. [0.01..0.9]
    compaction_headroom_ratio: 0.25
    # Fraction of the source transcript compaction aims to preserve verbatim. [0.01..0.9]
    compaction_preservation_ratio: 0.1
    # Default token level that triggers compaction when the profile does not declare compactionThresholdTokens. [10000..100000000]
    compaction_threshold_tokens: 200000
    # Milliseconds to wait for a complete non-streaming provider JSON response. [1000..3600000]
    json_response_timeout_ms: 120000
    # Default provider context length in tokens when the profile does not declare maxContextLength and no model rule infers one. [8000..100000000]
    max_context_length: 200000
    # Fallback max output tokens per provider request when neither the request nor the provider profile specifies one. [256..1000000]
    max_output_tokens: 16384
    # Default attempts per OpenAI-kind request before the turn fails; per-call maxAttempts wins. [1..20]
    openai_max_attempts: 6
    # Escalating retry backoff ladder in milliseconds for OpenAI-kind provider requests; attempts beyond the ladder reuse its last entry. [0..600000]
    openai_retry_delays_ms:
      - 1000
      - 3000
      - 5000
      - 10000
      - 30000
    # Safety margin subtracted from the provider output budget when sizing requests. [0..1000000]
    output_budget_safety_margin_tokens: 4096
    # Milliseconds to wait for a partial-output sink acknowledgement before proceeding without it. [100..600000]
    partial_output_ack_timeout_ms: 5000
    # Milliseconds to wait for a provider request to start streaming before the attempt is failed as timed out. [1000..3600000]
    request_start_timeout_ms: 120000
    # Milliseconds of stream silence tolerated before a provider attempt is failed as idle. [1000..3600000]
    stream_idle_timeout_ms: 60000
    # Default milliseconds for a provider token-count request; per-profile tokenCountTimeoutMs and per-call options win. [1000..600000]
    token_count_timeout_ms: 15000
    # Default milliseconds for a whole provider request; per-profile totalRequestTimeoutMs and per-call options win. [10000..7200000]
    total_request_timeout_ms: 600000
  runtime:
    # Milliseconds runtime close waits for component cleanup before reporting the close as failed. [500..600000]
    close_failure_ms: 10000
  storage:
    # Default milliseconds to wait for a storage file lock before the operation fails; explicit per-call timeouts win. [500..60000]
    lock_timeout_ms: 5000
  subagents:
    # Milliseconds a subagent continuation lease stays valid before it may be re-claimed. [1000..3600000]
    continuation_lease_ms: 30000
    # Maximum nesting depth for subagents spawning subagents. [1..10]
    max_depth: 2
    # Maximum live subagent processes per runtime instance; at capacity the Agent tool returns the live-children roster instead of spawning. [1..64]
    max_live: 8
    # Milliseconds between a resident subagent's mailbox polls while idle between turns. [100..60000]
    resident_poll_ms: 1000
  tasks:
    # Milliseconds health-check work gets to drain during shutdown. [500..600000]
    health_drain_timeout_ms: 10000
    # Byte cap per recorded health-check event excerpt. [256..10000000]
    health_event_excerpt_bytes: 4096
    # Byte size at which a health-check log rotates. [65536..1073741824]
    health_log_max_bytes: 4194304
    # Rotated health-check log files kept. [1..100]
    health_log_rotations: 3
    # Default milliseconds between monitor checks; per-monitor checkIntervalMs wins. [250..3600000]
    monitor_check_interval_ms: 5000
    # Default milliseconds between monitor heartbeats; per-monitor value wins. [1000..86400000]
    monitor_heartbeat_interval_ms: 60000
    # Minimum new output bytes for a monitor observation to count as progress. [1..1000000]
    monitor_min_progress_bytes: 120
    # Minimum milliseconds between narrated monitor updates. [1000..3600000]
    monitor_narration_spacing_ms: 20000
    # Character cap for narrated monitor output excerpts. [200..1000000]
    monitor_output_excerpt_chars: 6000
    # Milliseconds between monitor runtime ticks; per-call tickIntervalMs wins. [100..60000]
    monitor_tick_ms: 1500
  tools:
    # Default bytes per ReadToolArtifact page when the call does not specify max_bytes. [256..24000]
    artifact_page_bytes: 16384
    # Unchanged context lines around each hunk in file-change diffs. [0..100]
    diff_context_lines: 3
    # Default milliseconds a streaming code search may run; per-call timeouts win. [1000..3600000]
    search_timeout_ms: 120000
    # Milliseconds between TaskOutput polls while blocking on a running task. [50..60000]
    task_output_poll_ms: 250
  web:
    # Milliseconds of WebFetch body silence tolerated before the fetch fails; per-call overrides win. [500..600000]
    fetch_body_idle_timeout_ms: 10000
    # Milliseconds to establish a WebFetch connection; per-call overrides win. [500..600000]
    fetch_connect_timeout_ms: 10000
    # Milliseconds to receive WebFetch response headers; per-call overrides win. [500..600000]
    fetch_headers_timeout_ms: 10000
    # Maximum redirects followed per WebFetch acquisition. [0..20]
    fetch_max_redirects: 5
    # Comma-separated hostnames, IP addresses, or CIDR blocks exempted from the web fetch plane's private-address block (loopback, RFC1918, and other non-global destinations); link-local and cloud-metadata endpoints are never exempted.
    fetch_private_host_allowlist: ""
    # Total milliseconds for one WebFetch acquisition; per-call overrides win. [1000..3600000]
    fetch_total_timeout_ms: 30000
