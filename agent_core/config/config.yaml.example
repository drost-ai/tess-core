# Runtime configuration knobs — generated from agent_core/config/_knobs.py.
# Copy wanted entries under the `knobs:` section of
# <runtime-home>/settings/config.yaml. Values shown are the defaults.
# Environment overrides: AGENT_CORE_<NAME> with dots as underscores,
# e.g. AGENT_CORE_SUBAGENTS_MAX_LIVE=4.

knobs:
  daemon:
    # Milliseconds between the runtime's liveness checks of its containment daemon; a dead daemon is replaced by exactly one fresh instance. [50..60000]
    heartbeat_ms: 3000
    # Milliseconds between the containment daemon's liveness checks of its owner runtime process; owner death kills all owned workers and exits the daemon. [50..60000]
    owner_poll_ms: 2000
  process:
    # Milliseconds an owned worker process gets to disappear after SIGKILL before termination is reported as failed. [100..60000]
    kill_grace_ms: 1000
    # Milliseconds an owned worker process gets to exit after SIGTERM before the runtime escalates to SIGKILL. [100..60000]
    term_grace_ms: 3000
  provider:
    # Quick-retry delay ladder in milliseconds for Anthropic messages requests; a small random jitter is added on top. [0..600000]
    anthropic_retry_delays_ms:
      - 350
      - 700
    # Milliseconds to wait for a complete non-streaming provider JSON response. [1000..3600000]
    json_response_timeout_ms: 120000
    # Fallback max output tokens per provider request when neither the request nor the provider profile specifies one. [256..1000000]
    max_output_tokens: 16384
    # Escalating retry backoff ladder in milliseconds for OpenAI-kind provider requests; attempts beyond the ladder reuse its last entry. [0..600000]
    openai_retry_delays_ms:
      - 1000
      - 3000
      - 5000
      - 10000
      - 30000
    # Milliseconds to wait for a provider request to start streaming before the attempt is failed as timed out. [1000..3600000]
    request_start_timeout_ms: 120000
    # Milliseconds of stream silence tolerated before a provider attempt is failed as idle. [1000..3600000]
    stream_idle_timeout_ms: 60000
  subagents:
    # Maximum live subagent processes per runtime instance; at capacity the Agent tool returns the live-children roster instead of spawning. [1..64]
    max_live: 8
