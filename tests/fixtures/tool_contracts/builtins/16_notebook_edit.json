{
  "name": "NotebookEdit",
  "description": "Edit Jupyter notebook cells by ID.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "notebook_path": {
        "type": "string"
      },
      "cell_id": {
        "type": "string"
      },
      "new_source": {
        "type": "string"
      },
      "cell_type": {
        "type": "string",
        "enum": [
          "code",
          "markdown",
          "raw"
        ]
      },
      "edit_mode": {
        "type": "string",
        "enum": [
          "replace",
          "insert",
          "delete"
        ]
      }
    },
    "required": [
      "notebook_path",
      "new_source"
    ],
    "additionalProperties": false
  }
}
