{
  "name": "Glob",
  "description": "List files that match a glob pattern.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "pattern": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "offset": {
        "type": "number"
      },
      "cursor": {
        "type": "string",
        "description": "Opaque continuation cursor returned by a previous Glob page. Do not combine with offset."
      },
      "limit": {
        "type": "number"
      }
    },
    "required": [
      "pattern"
    ],
    "additionalProperties": false
  }
}
