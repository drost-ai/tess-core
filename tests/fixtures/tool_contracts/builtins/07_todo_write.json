{
  "description": "Update the session todo list.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "todos": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "activeForm": {
              "description": "Present-progress label of at most 1000 UTF-8 bytes. This limit is enforced at runtime.",
              "type": "string"
            },
            "content": {
              "description": "Non-empty todo text of at most 2000 UTF-8 bytes. This limit is enforced at runtime.",
              "type": "string"
            },
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "completed"
              ],
              "type": "string"
            }
          },
          "required": [
            "content",
            "status",
            "activeForm"
          ],
          "type": "object"
        },
        "description": "At most 100 items. This limit is enforced at runtime.",
        "type": "array"
      }
    },
    "required": [
      "todos"
    ],
    "type": "object"
  },
  "name": "TodoWrite"
}
