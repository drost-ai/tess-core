{
  "name": "Agent",
  "description": "Spawn a delegated resident subagent to work on a focused task. The call returns the child's initial result; the child stays alive for SendMessage follow-ups.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "description": {
        "type": "string"
      },
      "prompt": {
        "type": "string"
      },
      "subagent_type": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "team_name": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "default",
          "acceptEdits",
          "bypassPermissions",
          "dontAsk",
          "auto",
          "plan"
        ]
      },
      "isolation": {
        "type": "string",
        "enum": [
          "shared",
          "worktree",
          "none"
        ]
      }
    },
    "required": [
      "description",
      "prompt"
    ],
    "additionalProperties": false
  }
}
