{
  "description": "Spawn a delegated subagent to work on a focused task.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "description": {
        "type": "string"
      },
      "isolation": {
        "enum": [
          "shared",
          "worktree",
          "none"
        ],
        "type": "string"
      },
      "mode": {
        "enum": [
          "default",
          "acceptEdits",
          "bypassPermissions",
          "dontAsk",
          "auto",
          "plan"
        ],
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "prompt": {
        "type": "string"
      },
      "run_in_background": {
        "type": "boolean"
      },
      "subagent_type": {
        "type": "string"
      },
      "team_name": {
        "type": "string"
      }
    },
    "required": [
      "description",
      "prompt"
    ],
    "type": "object"
  },
  "name": "Agent"
}
