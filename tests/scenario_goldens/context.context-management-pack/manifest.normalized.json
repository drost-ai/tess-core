{
  "area": "context",
  "capture": {
    "include": [
      "session",
      "context_sessions",
      "context_driver_results",
      "compaction_results",
      "compaction_artifacts",
      "durable_memory",
      "continuation_results",
      "context_events",
      "context_runtime_state",
      "context_agent_results",
      "step_results"
    ]
  },
  "id": "context.context-management-pack",
  "mode": [
    "python"
  ],
  "setup": {
    "workspace": {
      "files": {
        "README.md": "context management harness\n"
      }
    }
  },
  "steps": [
    {
      "seed_context_session": {
        "alias": "accept",
        "manualMemoryText": "Prefer focused parity tests",
        "messageCount": 34,
        "profile": "plain"
      }
    },
    {
      "run_context_compaction": {
        "mode": "accept",
        "resultAlias": "accept"
      }
    },
    {
      "assert_context_result": {
        "alias": "accept",
        "family": "compaction",
        "status": "completed",
        "textContains": "rich"
      }
    },
    {
      "assert_compaction_artifact": {
        "alias": "accept",
        "memoryContains": "Use fixed Codex Spark compaction model selection",
        "nextStepContains": "Persist checkpoint artifacts",
        "qualityClassification": "rich"
      }
    },
    {
      "run_context_fallback": {}
    },
    {
      "assert_context_result": {
        "family": "compaction",
        "index": 1,
        "status": "passed",
        "textContains": "fallback"
      }
    },
    {
      "seed_context_session": {
        "alias": "repair",
        "messageCount": 34,
        "profile": "plain"
      }
    },
    {
      "run_context_compaction": {
        "mode": "repair",
        "resultAlias": "repair"
      }
    },
    {
      "assert_context_result": {
        "alias": "repair",
        "family": "compaction",
        "status": "completed",
        "textContains": "repair accepted"
      }
    },
    {
      "assert_compaction_artifact": {
        "alias": "repair",
        "nextStepContains": "run focused context harness tests",
        "qualityClassification": "usable"
      }
    },
    {
      "apply_context_relief": {
        "alias": "api",
        "messageCount": 18,
        "profile": "tool_heavy",
        "reactiveAttempt": 1
      }
    },
    {
      "assert_context_result": {
        "alias": "api",
        "family": "continuation",
        "modesInclude": [
          "api_microcompact"
        ],
        "textContains": "provider-aware aggressive microcompact"
      }
    },
    {
      "apply_context_relief": {
        "alias": "memory",
        "messageCount": 44,
        "profile": "plain",
        "reactiveAttempt": 2,
        "retrievedMemory": true
      }
    },
    {
      "assert_context_result": {
        "alias": "memory",
        "family": "continuation",
        "modesInclude": [
          "session_memory_compaction"
        ],
        "textContains": "durable memory:"
      }
    },
    {
      "apply_context_relief": {
        "alias": "partial",
        "messageCount": 44,
        "profile": "plain",
        "reactiveAttempt": 1
      }
    },
    {
      "assert_context_result": {
        "alias": "partial",
        "family": "continuation",
        "modesInclude": [
          "partial_compaction"
        ],
        "textContains": "bounded partial summary"
      }
    },
    {
      "project_context_events": {}
    },
    {
      "assert_context_runtime_state": {
        "lastReinjectionSummary": "summary",
        "pressureLevel": "high",
        "reactiveAttempt": 0,
        "selectedMode": "api_microcompact"
      }
    },
    {
      "run_reactive_context_retry": {}
    },
    {
      "assert_context_result": {
        "eventsInclude": [
          "context_relief.applied"
        ],
        "family": "agent",
        "index": 0,
        "status": "passed",
        "textContains": "lastContextReliefReactiveAttempt"
      }
    },
    {
      "run_reactive_context_cancellation": {}
    },
    {
      "assert_context_result": {
        "eventsInclude": [
          "turn.cancelled"
        ],
        "family": "agent",
        "index": 1,
        "status": "passed",
        "textContains": "cancelled"
      }
    },
    {
      "capture": {
        "include": [
          "session",
          "context_sessions",
          "context_driver_results",
          "compaction_results",
          "compaction_artifacts",
          "durable_memory",
          "continuation_results",
          "context_events",
          "context_runtime_state",
          "context_agent_results",
          "step_results"
        ]
      }
    }
  ],
  "title": "Context Compaction And Continuation Pack"
}
