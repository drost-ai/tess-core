{
  "id": "remote.remote-bridge-collaboration-pack",
  "title": "Remote Bridge Collaboration Pack",
  "area": "remote",
  "mode": ["python"],
  "setup": {
    "workspace": {
      "files": {
        "README.md": "remote bridge collaboration harness\n"
      }
    }
  },
  "steps": [
    {
      "create_session": {
        "permissionMode": "bypassPermissions"
      }
    },
    {
      "seed_collaboration_fixture": {}
    },
    {
      "create_remote_bridge": {
        "alias": "main",
        "remoteId": "remote-main",
        "bridgeId": "bridge-main",
        "description": "Remote QA",
        "name": "qa",
        "attachSession": true
      }
    },
    {
      "queue_bridge_message": {
        "alias": "main",
        "text": "please review",
        "source": "remote",
        "messageAlias": "main-review"
      }
    },
    {
      "refresh_collaboration": {
        "alias": "initial"
      }
    },
    {
      "assert_collaboration_snapshot": {
        "activeCount": 2,
        "awaitingInputCount": 2,
        "backgroundCount": 5,
        "pendingBridgeMessages": 1,
        "remoteStatus": "awaiting_input",
        "bridgeStatus": "active",
        "workersInclude": {
          "Running worker": "running",
          "Awaiting plan": "awaiting_input",
          "Remote QA": "awaiting_input"
        },
        "eventsInclude": [
          "collaboration.snapshot",
          "subagent.status_changed",
          "monitor.status_changed",
          "remote.status_changed",
          "bridge.status_changed"
        ]
      }
    },
    {
      "poll_bridge_inbox": {
        "alias": "main"
      }
    },
    {
      "collect_bridge_diagnostics": {
        "alias": "main"
      }
    },
    {
      "assert_bridge_diagnostics": {
        "alias": "main",
        "status": "active",
        "remoteStatus": "awaiting_input",
        "bridgeStatus": "active",
        "pendingMessages": 0,
        "messageCount": 1,
        "inboxCount": 1,
        "eventsInclude": [
          "bridge.started",
          "bridge.message.queued",
          "bridge.message.received"
        ],
        "textContains": "please review"
      }
    },
    {
      "update_child_agent_status": {
        "alias": "running",
        "status": "completed",
        "completedAt": "2026-01-01T00:00:07Z",
        "lastUpdatedAt": "2026-01-01T00:00:07Z",
        "completionReason": "finished",
        "resultSummary": "Delivered runtime notes.",
        "latestResultAt": "2026-01-01T00:00:07Z",
        "stoppable": false
      }
    },
    {
      "refresh_collaboration": {
        "alias": "after-running-completed"
      }
    },
    {
      "assert_collaboration_snapshot": {
        "index": 1,
        "activeCount": 1,
        "awaitingInputCount": 2,
        "backgroundCount": 5,
        "pendingBridgeMessages": 0,
        "workersInclude": {
          "Running worker": "completed",
          "Failed worker": "failed",
          "Awaiting plan": "awaiting_input"
        },
        "eventsInclude": [
          "subagent.status_changed"
        ]
      }
    },
    {
      "create_remote_bridge": {
        "alias": "replay",
        "remoteId": "remote-replay",
        "bridgeId": "bridge-replay",
        "description": "Replay Remote",
        "name": "replay",
        "attachSession": false
      }
    },
    {
      "queue_bridge_message": {
        "alias": "replay",
        "text": "already delivered",
        "source": "remote",
        "messageAlias": "replay-first"
      }
    },
    {
      "poll_bridge_inbox": {
        "alias": "replay"
      }
    },
    {
      "queue_bridge_message": {
        "alias": "replay",
        "text": "deliver after restart",
        "source": "remote",
        "messageAlias": "replay-second"
      }
    },
    {
      "reconnect_bridge": {
        "alias": "replay",
        "name": "replay"
      }
    },
    {
      "poll_bridge_inbox": {
        "alias": "replay"
      }
    },
    {
      "collect_bridge_diagnostics": {
        "alias": "replay"
      }
    },
    {
      "assert_bridge_diagnostics": {
        "alias": "replay",
        "status": "active",
        "pendingMessages": 0,
        "messageCount": 1,
        "inboxCount": 1,
        "eventsInclude": [
          "bridge.started",
          "bridge.message.received"
        ],
        "textContains": "deliver after restart"
      }
    },
    {
      "create_remote_bridge": {
        "alias": "failure",
        "remoteId": "remote-failure",
        "bridgeId": "bridge-failure",
        "description": "Failure Remote",
        "name": "failure",
        "attachSession": false
      }
    },
    {
      "set_bridge_emit_failure": {
        "alias": "failure",
        "enabled": true
      }
    },
    {
      "queue_bridge_message": {
        "alias": "failure",
        "text": "retry me",
        "source": "remote",
        "messageAlias": "failure-retry"
      }
    },
    {
      "poll_bridge_inbox": {
        "alias": "failure",
        "expectFailure": true
      }
    },
    {
      "collect_bridge_diagnostics": {
        "alias": "failure"
      }
    },
    {
      "assert_bridge_diagnostics": {
        "alias": "failure",
        "status": "active",
        "remoteStatus": "active",
        "bridgeStatus": "active",
        "pendingMessages": 1,
        "messageCount": 0,
        "inboxCount": 1,
        "eventsInclude": [
          "bridge.poll_failed"
        ],
        "textContains": "emit failure for failure"
      }
    },
    {
      "set_bridge_emit_failure": {
        "alias": "failure",
        "enabled": false
      }
    },
    {
      "poll_bridge_inbox": {
        "alias": "failure"
      }
    },
    {
      "collect_bridge_diagnostics": {
        "alias": "failure"
      }
    },
    {
      "assert_bridge_diagnostics": {
        "alias": "failure",
        "status": "active",
        "remoteStatus": "awaiting_input",
        "bridgeStatus": "active",
        "pendingMessages": 0,
        "messageCount": 1,
        "inboxCount": 1,
        "eventsInclude": [
          "bridge.poll_failed",
          "bridge.message.received"
        ],
        "textContains": "retry me"
      }
    },
    {
      "bootstrap_remote_runtime": {
        "bridgeName": "qa"
      }
    },
    {
      "assert_remote_result": {
        "driver": "bootstrap_remote_runtime",
        "status": "passed",
        "textContains": "bridgeAttached"
      }
    },
    {
      "project_remote_events": {}
    },
    {
      "assert_remote_runtime_state": {
        "bridgeAttached": true,
        "bridgeLastEventName": "remote.status_changed",
        "remoteStatus": "awaiting_input",
        "pendingBridgeMessages": 0
      }
    },
    {
      "capture": {
        "include": [
          "session",
          "remote_driver_results",
          "remote_sessions",
          "bridge_records",
          "bridge_inbox",
          "bridge_events",
          "bridge_diagnostics",
          "remote_events",
          "collaboration_events",
          "collaboration_snapshots",
          "remote_runtime_state",
          "remote_projected_events",
          "remote_bootstrap_results",
          "remote_bootstrap_events",
          "step_results"
        ]
      }
    }
  ],
  "capture": {
    "include": [
      "session",
      "remote_driver_results",
      "remote_sessions",
      "bridge_records",
      "bridge_inbox",
      "bridge_events",
      "bridge_diagnostics",
      "remote_events",
      "collaboration_events",
      "collaboration_snapshots",
      "remote_runtime_state",
      "remote_projected_events",
      "remote_bootstrap_results",
      "remote_bootstrap_events",
      "step_results"
    ]
  }
}
