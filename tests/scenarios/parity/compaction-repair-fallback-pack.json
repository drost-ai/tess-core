{
  "id": "parity.compaction-repair-fallback-pack",
  "title": "Compaction Repair And Fallback Parity Pack",
  "area": "parity",
  "mode": ["parity"],
  "tags": ["ci", "parity", "compaction"],
  "capabilities": ["node", "typescript_repo"],
  "setup": {
    "workspace": {
      "files": {
        "README.md": "repair and fallback compaction parity\n",
        "agent_core/context/compaction.py": "def checkpoint():\n    return 'v2 parity'\n",
        "plans/compaction-v2.md": "# Compaction V2 Plan\n\n- Cover repair paths.\n- Cover retry and skip paths.\n"
      }
    }
  },
  "steps": [
    {
      "parity_action": {
        "action": "compaction_run",
        "name": "malformed-synthesis-recovers",
        "sessionId": "compaction-repair-malformed",
        "force": true,
        "script": {
          "synthesis": [{"kind": "malformed_json"}, {"kind": "success", "textFixture": "rich-working-context"}],
          "verification": [{"kind": "success", "textFixture": "accept-rich"}]
        }
      }
    },
    {
      "parity_action": {
        "action": "compaction_run",
        "name": "incomplete-synthesis-recovers",
        "sessionId": "compaction-repair-incomplete",
        "force": true,
        "script": {
          "synthesis": [{"kind": "incomplete_context"}, {"kind": "success", "textFixture": "usable-working-context"}],
          "verification": [{"kind": "success", "textFixture": "accept-rich"}]
        }
      }
    },
    {
      "parity_action": {
        "action": "compaction_run",
        "name": "verifier-repair-accepted",
        "sessionId": "compaction-repair-accepted",
        "force": true,
        "script": {
          "synthesis": [{"kind": "success", "textFixture": "rich-working-context"}],
          "verification": [{"kind": "success", "textFixture": "repair-rich"}, {"kind": "success", "textFixture": "accept-rich"}]
        }
      }
    },
    {
      "parity_action": {
        "action": "compaction_run",
        "name": "retryable-synthesis-fallback",
        "sessionId": "compaction-repair-retryable",
        "force": true,
        "script": {
          "synthesis": [{"kind": "retryable_error"}, {"kind": "success", "textFixture": "rich-working-context"}],
          "verification": [{"kind": "success", "textFixture": "accept-rich"}]
        }
      }
    },
    {
      "parity_action": {
        "action": "compaction_run",
        "name": "context-size-synthesis-fallback",
        "sessionId": "compaction-repair-context-size",
        "force": true,
        "script": {
          "synthesis": [{"kind": "context_size_error"}, {"kind": "success", "textFixture": "rich-working-context"}],
          "verification": [{"kind": "success", "textFixture": "accept-rich"}]
        }
      }
    },
    {
      "parity_action": {
        "action": "compaction_run",
        "name": "verifier-reject-skips",
        "sessionId": "compaction-repair-reject",
        "force": true,
        "script": {
          "synthesis": [{"kind": "success", "textFixture": "rich-working-context"}],
          "verification": [{"kind": "reject"}]
        }
      }
    },
    {
      "parity_action": {
        "action": "compaction_run",
        "name": "low-value-candidate-skips",
        "sessionId": "compaction-repair-low-value",
        "force": true,
        "script": {
          "synthesis": [{"kind": "success", "textFixture": "skip-low-value"}]
        }
      }
    },
    {
      "parity_action": {
        "action": "compaction_run",
        "name": "unsafe-cutoff-skips",
        "sessionId": "compaction-repair-unsafe-cutoff",
        "fixture": "unsafe-cutoff-session",
        "force": true,
        "script": {}
      }
    }
  ],
  "capture": {
    "include": [
      "parity_summary",
      "parity_python",
      "parity_typescript",
      "parity_comparison"
    ]
  }
}
